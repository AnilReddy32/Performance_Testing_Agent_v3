ENVIRONMENT=development

OPENAI_API_KEY=

# Passive external-surface assessment (default on). It sends no attack payloads:
# one TLS handshake plus at most five HEAD/GET/OPTIONS requests to the job's own
# public HTTPS target. See the README section "Automatic passive security
# assessment of external APIs".
# SECURITY_AUTO_ASSESSMENT_ENABLED=true
# SECURITY_PASSIVE_ASSESSMENT_ENABLED=true

# Older single-HEAD observation, used only when passive assessment is off.
# SECURITY_LIVE_TESTS_ENABLED=false
